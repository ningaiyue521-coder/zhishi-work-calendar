<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="知时 · 工作日历" Width="1250" Height="850" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F4F6F4" FontFamily="Microsoft YaHei UI" Foreground="#213B3C">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE7E3"/><Setter Property="Foreground" Value="#274849"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#CBD9D3"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#E4EBE6"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#203C40"/><Setter Property="Foreground" Value="#D6E6DF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="#203C40"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="16,13"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#193338"><Grid Margin="20,30,20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="知时" Foreground="#ECF5EF" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="WORK CALENDAR" Foreground="#96B8AB" FontSize="10" Margin="2,6,0,38"/></StackPanel>
      <StackPanel Grid.Row="1"><Button x:Name="NavCalendar" Content="日历总览" Style="{StaticResource Nav}"/><Button x:Name="NavInbox" Content="待核对" Style="{StaticResource Nav}"/><Button x:Name="NavLogs" Content="工作轨迹" Style="{StaticResource Nav}"/><Button x:Name="NavSettings" Content="采集设置" Style="{StaticResource Nav}"/></StackPanel>
      <StackPanel Grid.Row="3"><Border CornerRadius="9" Background="#27464A" Padding="13"><StackPanel><TextBlock Text="留意工作，记住安排" Foreground="#D2E4D9" FontSize="12"/><TextBlock Text="日历在本机 · 云端可配置" Foreground="#95B2A9" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="本地版 0.2  /  Windows" Foreground="#75978B" FontSize="10" Margin="2,18,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="27,24,27,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><StackPanel><TextBlock x:Name="HeaderDate" FontSize="12" Foreground="#748D80"/><TextBlock Text="让工作，自有安排。" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="AddMessage" Content="＋  录入一条消息"/><Button x:Name="Export" Content="导出日历" Margin="0"/></StackPanel></Grid>
      <Border Grid.Row="1" CornerRadius="10" Background="#E5EEE7" Padding="18,13" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CaptureState" Text="采集已暂停" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="CaptureDetail" Text="开始后自动读取前台窗口文字与可见通知，云端推理需先配置 API。" Foreground="#577569" FontSize="12" Margin="0,6,12,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="ToggleCapture" Grid.Column="1" Content="开始记录" Background="#21796A" Foreground="White" BorderBrush="#21796A" Margin="0" VerticalAlignment="Center"/></Grid></Border>
      <Grid Grid.Row="2">
        <Grid x:Name="CalendarPage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <UniformGrid Grid.ColumnSpan="2" Columns="3" Margin="0,0,0,16"><Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ActiveCount" Text="0" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="已安排" Margin="15,11,0,0" Foreground="#798C7E"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PendingCount" Text="0" FontSize="26" Foreground="#B17F39" FontWeight="SemiBold"/><TextBlock Text="待核对" Margin="15,11,0,0" Foreground="#798C7E"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="16,12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="LogCount" Text="0" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="今日工作片段" Margin="15,11,0,0" Foreground="#798C7E"/></StackPanel></Border></UniformGrid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="17"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="205"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="70"/></Grid.RowDefinitions><Grid><TextBlock x:Name="MonthTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PrevMonth" Content="‹" Padding="10,4"/><Button x:Name="Today" Content="今天" Padding="10,4"/><Button x:Name="NextMonth" Content="›" Padding="10,4" Margin="0"/></StackPanel></Grid><UniformGrid Grid.Row="1" Columns="7" Margin="0,18,0,6"><TextBlock Text="一" HorizontalAlignment="Center" Foreground="#859489"/><TextBlock Text="二" HorizontalAlignment="Center" Foreground="#859489"/><TextBlock Text="三" HorizontalAlignment="Center" Foreground="#859489"/><TextBlock Text="四" HorizontalAlignment="Center" Foreground="#859489"/><TextBlock Text="五" HorizontalAlignment="Center" Foreground="#859489"/><TextBlock Text="六" HorizontalAlignment="Center" Foreground="#859489"/><TextBlock Text="日" HorizontalAlignment="Center" Foreground="#859489"/></UniformGrid><UniformGrid x:Name="MonthGrid" Grid.Row="2" Columns="7" Rows="6"/><TextBlock x:Name="SelectedDateLabel" Grid.Row="3" FontWeight="SemiBold" Margin="0,15,0,12"/><ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DayEvents"/></ScrollViewer></Grid></Border>
          <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details"/></ScrollViewer></Border>
        </Grid>
        <Border x:Name="InboxPage" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="待核对的工作安排" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="缺少时间、屏幕历史消息和改期通知会在这里等待核对。" Foreground="#718A7D" Margin="0,8,0,0"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="InboxItems"/></ScrollViewer></Grid></Border>
        <Border x:Name="LogsPage" Style="{StaticResource Card}" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="工作轨迹" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="记录前台程序、窗口标题和活跃片段；不等同于已完成的工作。空闲三分钟暂停统计。" Foreground="#718A7D" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LogItems"/></ScrollViewer></Grid></Border>
        <Border x:Name="SettingsPage" Style="{StaticResource Card}" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="让记录保持在你的掌控中" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="采集范围" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="每 8 秒查看前台工作窗口，并尝试读取屏幕上出现的系统通知。不点击、不发送消息。后台未展示内容、被遮挡区域和软件自绘通知可能无法读取。" Foreground="#718A7D" Margin="0,8,0,15" TextWrapping="Wrap"/><CheckBox x:Name="OcrEnabled" Content="窗口文字不足时，使用本机中文 OCR" Margin="0,0,0,12"/><CheckBox x:Name="ToastsEnabled" Content="尝试识别可见的 Windows 通知" Margin="0,0,0,20"/><TextBlock Text="排除的程序名（用英文逗号分隔，不含 .exe）" Margin="0,0,0,8"/><TextBox x:Name="ExcludedApps"/><TextBlock Text="Codex / ChatGPT、密码、登录等窗口及本程序始终排除；截图只在内存中处理。" Foreground="#718A7D" FontSize="12" Margin="0,8,0,23"/><TextBlock Text="云端模型 · 自动推理" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="启用后，将候选工作文字、来源、同会话近期消息、相关日程和填写的姓名发送至下方 API，用于理解后续安排。截图不上传。" Foreground="#718A7D" TextWrapping="Wrap" Margin="0,8,0,12"/><CheckBox x:Name="CloudEnabled" Content="启用云端推理，自动分析新发现的工作消息" Margin="0,0,0,14"/><TextBlock Text="API 地址（OpenAI 兼容，例如 https://api.example.com/v1）" Margin="0,0,0,7"/><TextBox x:Name="ApiBase" Margin="0,0,0,12"/><TextBlock Text="模型名（填写你的服务实际支持的模型）" Margin="0,0,0,7"/><TextBox x:Name="ModelName" Margin="0,0,0,12"/><TextBlock Text="API Key（仅在当前 Windows 账户下加密保存）" Margin="0,0,0,7"/><PasswordBox x:Name="ApiKey" Padding="10" FontSize="14" BorderBrush="#CBD9D3"/><Button x:Name="SaveSettings" Content="保存设置" HorizontalAlignment="Left" Background="#21796A" Foreground="White" Margin="0,20,0,20"/><TextBlock Text="提醒与退出" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="已确认的具体时间默认提前 15 分钟弹窗提醒。关闭主窗口会继续留在系统托盘；电脑睡眠期间不能提醒，恢复后补提醒最近一天内的事项。彻底退出或关机后不会提醒。此版本未设置开机自启。" Foreground="#718A7D" Margin="0,8,0,20" TextWrapping="Wrap"/><Button x:Name="Quit" Content="彻底退出程序" HorizontalAlignment="Left"/></StackPanel></ScrollViewer></Border>
      </Grid>
      <TextBlock x:Name="Footer" Grid.Row="3" Text="就绪 · 自动记录的原文可在事项详情查看" FontSize="11" Foreground="#7B8F81" Margin="2,13,0,0" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>
